<!-- views/partials/header.ejs -->
<nav class="navbar">
  <div class="nav-inner">
    <a href="/" class="brand">Game<span>Pilot</span> 🎮</a>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/games">Browse</a></li>
      <li><a href="/games/search">Search</a></li>
      <li><a href="/games/add">Suggest Game</a></li>
<% if (user) { %>
    <li class="dropdown">
      <a href="#" class="dropbtn"><%= user.displayName || user.username %> ▾</a>
      <div class="dropdown-content">
  <a href="/auth/profile">My Profile</a>
  <a href="/auth/favorites">My Favorites</a>
  <form action="/auth/logout" method="POST">
    <button type="submit" class="logout-btn">Logout</button>
  </form>
</div>
    </li>
  <% } else { %>
    <li><a href="/auth/login">Login</a></li>
    <li><a href="/auth/register">Register</a></li>
  <% } %>

    <li class="dropdown">
        <a href="#" class="dropbtn">API Tests ▾</a>
        <div class="dropdown-content">
          <a href="/api/status" target="_blank">Server Status</a>
          <a href="/api/games" target="_blank">All Games (JSON)</a>
          <a href="/api/games?page=1&perPage=10" target="_blank">Pagination Test</a>
          <a href="/api/games?genre=Action" target="_blank">Search (Action)</a>
          <a href="/api/games/1" target="_blank">Single Game (ID: 1)</a>
        </div>
      </li>
    </ul>
  </div>
</nav>
<% if (flash) { %>
  <div class="<%= flash.type === 'success' ? 'success-box' : 'error-box' %> flash-message container">
    <%= flash.message %>
  </div>
<% } %>
