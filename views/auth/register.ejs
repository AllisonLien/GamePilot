<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register | GamePilot</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <%- include('../partials/header') %>

  <main class="container">

    <div class="page-heading">
      <h1>Create an Account</h1>
      <p>Sign up to save your favourite games and get personalized picks.</p>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="error-box">
        <ul>
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/auth/register" class="search-form add-game-form">
      <div class="form-group">
        <label for="username">Username *</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= formData.username || '' %>"
        >
      </div>

      <div class="form-group">
        <label for="email">Email *</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= formData.email || '' %>"
        >
      </div>

      <div class="form-group">
        <label for="displayName">Display Name</label>
        <input
          type="text"
          id="displayName"
          name="displayName"
          value="<%= formData.displayName || '' %>"
        >
      </div>

      <div class="form-group">
        <label for="password">Password *</label>
        <input
          type="password"
          id="password"
          name="password"
        >
      </div>

      <button type="submit" class="btn btn-primary">Register</button>
    </form>

    <p>Already have an account? <a href="/auth/login">Log in here</a>.</p>

  </main>

  <%- include('../partials/footer') %>

</body>
</html>