<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password | GamePilot</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container">
    <div class="page-heading">
      <h1>Forgot Password</h1>
      <p>Enter your email to get a password reset link.</p>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="error-box">
        <ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul>
      </div>
    <% } %>

    <form method="POST" action="/auth/forgot-password" class="search-form add-game-form">
      <div class="form-group">
        <label for="email">Email *</label>
        <input type="email" id="email" name="email">
      </div>
      <button type="submit" class="btn btn-primary">Send Reset Link</button>
    </form>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>